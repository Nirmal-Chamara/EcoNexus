# Explicitly use development, test, staging or production. No implicit server mode.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/econexus
# Set a dedicated generated secret to retain local sessions across restarts.
# Development/test generate an ephemeral secret if blank; release requires >=32 bytes.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# Leave provisioning credentials out of the normal deployed server environment.
# Set these temporarily for npm run seed:admin; defaults are never accepted.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
ADMIN_PROVISIONED_BY=
ADMIN_PROVISION_REASON=

# Release requires a configured email provider and owned sending identity.
# Configure Resend, or all of SMTP_HOST / SMTP_USER / SMTP_PASSWORD.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Backend-only durable email encryption key; keep stable across API/worker restarts.
EMAIL_OUTBOX_KEY=
# Development can use econexus://. Release requires an owned HTTPS app-link base.
APP_LINK_BASE_URL=econexus://
# Release requires the intended OAuth client IDs, comma separated.
GOOGLE_CLIENT_ID=
# Release requires exact HTTPS browser origins, comma separated (no paths or wildcards).
CORS_ORIGIN=
# Optional private DB certificate authority, with literal \n between PEM lines.
DATABASE_SSL_CA=
# Never disable certificate validation in staging/production.
